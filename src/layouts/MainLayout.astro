---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Layout from "./Layout.astro";
---

<Layout>
    <div class="container">
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </div>
</Layout>

<style>
    .container {
        display: grid;
        min-height: 100vh;
        grid-template-rows: auto 1fr auto;
    }

    main {
        padding: 2rem;
        background-color: aliceblue;
    }
</style>
