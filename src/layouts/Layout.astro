---
import Head from "./Head.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts.ts";

interface Props {
	title?: string;
	description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html lang="es">
	<Head {title} {description} />
	<body>
		<slot />
	</body>
</html>
