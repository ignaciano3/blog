---
import Head from "./Head.astro";

interface Props {
	title?: string;
	description?: string;
}

const defaultTitle = "Blog de Ignacio Garcia Pizales";
const defaultDescription = "Blog sobre IA, software";

const { title = defaultTitle, description = defaultDescription } = Astro.props;
---

<!doctype html>
<html lang="es">
	<Head {title} {description} />
	<body>
		<slot />
	</body>
</html>
