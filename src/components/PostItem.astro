---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

type Props = CollectionEntry<"blog">;

const {
    data: { title, pubDate },
    id,
} = Astro.props;
---

<li>
    <a href={`/blog/${id}/`}>
        <h4>{title}</h4>
        <FormattedDate date={pubDate} />
    </a>
</li>
