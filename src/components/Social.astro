---
import { Image } from "astro:assets";
import { capitalize } from "../lib/string";

interface SocialNetwork {
    platform: string;
    username: string;
}

const socialNetworks = [
    { platform: "github", username: "ignaciano3" },
    { platform: "instagram", username: "ignaciogp08" },
    { platform: "linkedin", username: "in/ignacio-garcia-pizales" },
] as const satisfies SocialNetwork[];

type Platform = (typeof socialNetworks)[number]["platform"];

function getSocialNetworkHref(platform: Platform) {
    const socialNetwork = socialNetworks.find(
        (network) => network.platform === platform,
    )!;

    const href = `https://www.${socialNetwork.platform}.com/${socialNetwork.username}`;
    return href;
}

interface Props {
    platform: Platform;
}

const { platform } = Astro.props;
---

<a
    href={getSocialNetworkHref(platform)}
    target="_blank"
    rel="noopener noreferrer"
>
    <Image
        src={`/icons/${platform}.svg`}
        alt={capitalize(platform)}
        width={30}
        height={30}
    />
</a>
